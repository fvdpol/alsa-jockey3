#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# The complete set of root operations the Jockey 3 test framework performs.
#
#   jockey3-testctl <verb> [argument]
#
# Everything else the tests do -- opening the card, playing, capturing, MIDI,
# stopping the user's sound server, reading sysfs and /proc/config.gz -- runs
# as an ordinary user and must never appear here.
#
# WHY A SCRIPT RATHER THAN SUDOERS ENTRIES PER BINARY
# ---------------------------------------------------
# sudoers matches a command line, and its wildcards are far weaker than they
# look. `NOPASSWD: /sbin/modprobe *` grants the right to load ANY module,
# which is unrestricted root. Pinning every argument instead produces a dozen
# brittle entries that have to change whenever a case changes.
#
# One root-owned script with a fixed verb interface and validated arguments
# gives a boundary that can actually be reviewed: this file is the boundary,
# and reading it tells you the whole privileged surface of the test suite.
#
# INSTALLATION
# ------------
# This file is version-controlled in tests/hw/priv/ so it can be reviewed and
# changed under review, but it MUST be installed to a root-owned path before
# it is granted sudo rights -- a script sudo can run must not be writable by
# the user it grants privilege to, or the boundary is worthless. The Seafile
# share is user-writable, so running it from there under sudo would be exactly
# that mistake. Use install.sh.
#
# DELIBERATELY ABSENT: installing a module
# ----------------------------------------
# Copying a .ko into /lib/modules and loading it is arbitrary kernel code
# execution -- root by another name. Deploying a new driver build therefore
# stays a deliberate, password-protected act (see reload_driver.sh); only
# loading and unloading the ALREADY-INSTALLED module is automated here.

set -u

MODULE=snd-reloop-jockey3
MODULE_U=snd_reloop_jockey3
DYNDBG=/sys/kernel/debug/dynamic_debug/control

# The one dev_dbg carrying the firmware revision, in ploytec_proto.c:
#
#     dev_dbg(&intf->dev, "Firmware 0x%02x v%d.%d.%d\n", ...)
#
# Matched by format string so the log is not flooded by every other dev_dbg in
# the driver for the whole run -- which is what the blunt "dyndbg=+p" would do.
#
# Deliberately a single space-free word rather than the full format. dynamic
# debug matches this as a substring, so "Firmware" selects exactly the one
# callsite, and being space-free it needs no quoting inside the query. That
# matters on the modprobe path: the kernel's parse_args splits a parameter
# value at the first space, so "dyndbg=format \"Firmware 0x%02x\" +p" arrived
# as the fragment 'format "Firmware' -- which the tokenizer rejected with
# "unclosed quote" -- plus a junk parameter. modprobe still exited 0, so the
# only visible symptom was every run recording "firmware unknown".
FW_MATCH='Firmware'

# The one dev_dbg naming the sub-packets-per-URB count ("N") a direction was
# just armed with, in jockey3_pcm_set_n() (jockey3.c):
#
#     dev_dbg(&chip->intf0->dev,
#             "hw_params: %s using %u packet(s)/URB (period_bytes=%u)\n", ...)
#
# Space-free for the same reason FW_MATCH is, though this one is never used
# via the modprobe dyndbg= path -- see dyndbg-hwparams-n below.
HWPARAMS_N_MATCH='packet(s)/URB'

# The two URB completion handlers trace-callbacks profiles, for JT-PERF-001.
# Fixed here for the same reason FW_MATCH is: the caller names an ACTION
# (start/collect/stop), never a target function -- an arbitrary function name
# would let the suite point kernel tracing at anything.
TRACE_FUNCS='jockey3_playback_callback jockey3_capture_callback'

# The Jockey 3's own USB ids, for per-port power switching. Fixed here for the
# same reason FW_MATCH is: the caller names an ACTION, never a target. A verb
# taking a hub location and port would grant the suite the right to cut power
# to any port on any hub -- and on the test rig the hub one level up carries
# the keyboard, the mouse, and the hub this device hangs off. Resolving the
# port from the device's own vendor/product id means the only port that can
# ever be switched is one with a Jockey 3 plugged into it.
JOCKEY3_USB_IDS='200c:1037 200c:1019'      # Remix, Master Edition

# Where the resolved port is remembered between `off` and `on`.
#
# Once the port is powered down the device is gone from the bus, so it can no
# longer be found by its vendor/product id -- the location has to be carried
# across. /run is tmpfs, so a stale entry cannot outlive a reboot, and it is
# root-owned, so the record of which port to re-energize is not user-writable.
USB_STATE_DIR=/run/jockey3-testctl
USB_STATE=$USB_STATE_DIR/usb-port

die() { echo "jockey3-testctl: $*" >&2; exit 2; }

usage() {
	sed -n '/^# Verbs:/,/^$/p' "$0" | sed 's/^# \?//'
	exit 2
}

# Verbs:
#   status                 report that the helper is installed and usable
#   load                   modprobe the driver and its soundcore dependencies
#   unload                 rmmod the driver (no-op when not loaded)
#   unbind                 detach the driver from the device's interface 0
#                          (no-op if already unbound)
#   bind                   reattach the driver to interface 0
#                          (no-op if already bound)
#   dmesg-read             print the kernel log (dmesg --raw: keeps <N> priority)
#   dmesg-mark <token>     write a JT-MARK boundary token to /dev/kmsg
#   dyndbg-firmware on|off enable/disable the firmware-revision probe message
#   dyndbg-hwparams-n on|off enable/disable the hw_params() packets/URB (N) message
#   printk-console <1-8>   set the console loglevel
#   xrun-debug 0|1        make the ALSA core log every xrun to the kernel log
#   xrun-inject pcm0p|pcm0c   force an xrun on that substream's sub0, via
#                          CONFIG_SND_PCM_XRUN_DEBUG's xrun_injection file
#                          (a safe no-op if it is not open and running)
#   trace-callbacks start  begin function_graph tracing of the two URB
#                          completion handlers (JT-PERF-001)
#   trace-callbacks collect  stop tracing, print the trace buffer, reset
#                          tracing state
#   trace-callbacks stop  reset tracing state without printing anything
#                          (cleanup path for a case that errored before
#                          collect)
#   rtcwake-mem <1-3600>   suspend to RAM and wake after N seconds
#   usb-power status       report the ppps hub port the Jockey 3 is plugged into
#   usb-power off|on       cut or restore power to that port
#   usb-power cycle [1-30] off, wait N seconds (default 3), on

[ $# -ge 1 ] || usage
verb=$1
shift

# Every verb here needs root; that is the entire reason this file exists. Say
# so once, clearly, rather than letting each verb fail in its own way further
# down -- run without sudo, xrun-debug reported "Permission denied" against a
# proc path, which reads like a bug in the tool rather than a missing sudo.
if [ "$(id -u)" != 0 ]; then
	echo "jockey3-testctl: must run as root -- try:" >&2
	echo "    sudo $0 $verb $*" >&2
	exit 4
fi

# The Jockey 3's proc directory, resolved by card ID rather than by index.
# ALSA maintains /proc/asound/<id> as a symlink to the current cardN, and the
# index is not stable: booting with the device already powered on made it
# card0 where it had always been card1. Anything keyed on the number is wrong
# the first time somebody leaves the controller switched on.
card_proc() {
	local d
	for d in /proc/asound/RJ3 /proc/asound/Jockey3; do
		[ -d "$d" ] && { printf '%s' "$d"; return 0; }
	done
	# Fall back to matching the driver name in /proc/asound/cards, in case the
	# card id was overridden with the `id` module parameter.
	local n
	n=$(awk '/Jockey3|Reloop Jockey 3/ {print $1; exit}' /proc/asound/cards 2>/dev/null)
	[ -n "$n" ] && [ -d "/proc/asound/card$n" ] || return 1
	printf '/proc/asound/card%s' "$n"
}

# tracefs moved out from under debugfs a while back; both mount points are
# still seen in the wild depending on kernel/distro, so try the modern one
# first.
tracing_dir() {
	local d
	for d in /sys/kernel/tracing /sys/kernel/debug/tracing; do
		[ -d "$d" ] && { printf '%s' "$d"; return 0; }
	done
	return 1
}

# Print the sysfs kernel name of the Jockey 3's interface 0 (e.g. "1-1:1.0"),
# or fail.
#
# jockey3_probe() rejects every interface but 0 (see the check at the top of
# jockey3_probe() in jockey3.c), so interface 0 is the only kernel name that
# is ever bound to this driver by the bus's own driver model -- interface 1
# is claimed internally from inside that same probe() call, not matched
# through id_table. Unbinding/binding interface 0 is therefore what drives
# jockey3_disconnect()/jockey3_probe() for the whole device.
#
# Resolved fresh from idVendor/idProduct every time, the same way usb_resolve()
# is: the location must never be a caller-supplied argument, or this verb
# could be pointed at any USB interface on the machine.
usb_iface0_resolve() {
	local id f base d ifnum
	for id in $JOCKEY3_USB_IDS; do
		for f in /sys/bus/usb/devices/*/idVendor; do
			base=$(dirname "$f")
			[ "$(cat "$f" 2>/dev/null)" = "${id%%:*}" ] || continue
			[ "$(cat "$base/idProduct" 2>/dev/null)" = "${id##*:}" ] || continue
			for d in "$base":*; do
				[ -f "$d/bInterfaceNumber" ] || continue
				# sysfs renders this as two hex digits ("00", not "0"), so
				# it is decoded as hex rather than string-matched.
				ifnum=$(cat "$d/bInterfaceNumber" 2>/dev/null)
				[[ $ifnum =~ ^[0-9a-fA-F]+$ ]] || continue
				if [ "$((16#$ifnum))" -eq 0 ]; then
					basename "$d"
					return 0
				fi
			done
		done
	done
	return 1
}

# Print "<hub-location> <port> <hub-id>" for the port a Jockey 3 is plugged
# into, or fail.
#
# Only a port on a hub advertising `ppps` is accepted. Per-port power switching
# is what this is for, and on a hub without it uhubctl reports success while
# changing nothing -- a test that silently never disconnects the device would
# pass while proving nothing, which is worse than refusing.
usb_resolve() {
	local id out found
	for id in $JOCKEY3_USB_IDS; do
		out=$(uhubctl --search "$id" 2>/dev/null) || continue
		# uhubctl prints a "Current status for hub" header per hub, followed
		# by the matching port lines beneath it, so the hub in force is
		# whichever header was seen most recently.
		# Matched without the closing bracket: uhubctl appends the device
		# description when it can read one -- "[413c:2107 Dell USB Keyboard]"
		# -- and the Jockey 3 prints bare "[200c:1037]" only because its
		# strings are not readable while the driver holds it. Anchoring on
		# "[<vid>:<pid>]" would therefore work until the day it did not.
		# Product ids are always four hex digits, so a prefix cannot collide.
		found=$(printf '%s\n' "$out" | awk -v want="[$id" '
			/^Current status for hub / {
				hub = $5
				ppps = (index($0, "ppps") > 0)
				hubid = ""
				if (match($0, /\[[0-9a-f]+:[0-9a-f]+/))
					hubid = substr($0, RSTART + 1, RLENGTH - 1)
				next
			}
			/^[ \t]*Port [0-9]+:/ && ppps && index($0, want) > 0 {
				port = $2
				sub(/:$/, "", port)
				print hub, port, hubid
				exit
			}')
		[ -n "$found" ] && { printf '%s\n' "$found"; return 0; }
	done
	return 1
}

case "$verb" in
status)
	echo "jockey3-testctl ok"
	echo "module=$MODULE"
	echo "dyndbg=$([ -w "$DYNDBG" ] && echo yes || echo no)"
	exit 0
	;;

load)
	[ $# -eq 0 ] || die "load takes no arguments"
	# Explicit dependency loads: the driver declares a softdep on these, but
	# loading them first makes a missing soundcore module an obvious error
	# here rather than a confusing modprobe failure.
	modprobe snd-pcm || die "modprobe snd-pcm failed"
	modprobe snd-rawmidi || die "modprobe snd-rawmidi failed"
	# The firmware revision exists only as a dev_dbg emitted once, at probe,
	# so it has to be enabled before the module initializes -- hence the
	# dyndbg= module parameter rather than a write to the control file.
	#
	# Writing the control file cannot work here for two reasons: the callsite
	# does not exist while the module is unloaded, and dynamic_debug discards
	# a module's rules when it unloads, so a rule set once per test case is
	# gone after the first unload/reload.
	#
	# The inner double quotes are part of the value, not shell syntax:
	# parse_args splits a parameter value at whitespace unless the value is
	# quoted, and this query has spaces between its keywords.
	exec modprobe "$MODULE" "dyndbg=\"format $FW_MATCH +p\""
	;;

unload)
	[ $# -eq 0 ] || die "unload takes no arguments"
	grep -q "^${MODULE_U} " /proc/modules || exit 0
	exec rmmod "$MODULE"
	;;

unbind)
	[ $# -eq 0 ] || die "unbind takes no arguments"
	[ -d "/sys/bus/usb/drivers/$MODULE" ] || die "driver not loaded"
	kname=$(usb_iface0_resolve) || die "no Reloop Jockey 3 interface 0 found"
	[ -e "/sys/bus/usb/drivers/$MODULE/$kname" ] || exit 0
	echo "$kname" > "/sys/bus/usb/drivers/$MODULE/unbind" \
		|| die "unbind failed for $kname"
	exit 0
	;;

bind)
	[ $# -eq 0 ] || die "bind takes no arguments"
	[ -d "/sys/bus/usb/drivers/$MODULE" ] || die "driver not loaded"
	kname=$(usb_iface0_resolve) || die "no Reloop Jockey 3 interface 0 found"
	[ -e "/sys/bus/usb/drivers/$MODULE/$kname" ] && exit 0
	echo "$kname" > "/sys/bus/usb/drivers/$MODULE/bind" \
		|| die "bind failed for $kname"
	exit 0
	;;

dmesg-read)
	[ $# -eq 0 ] || die "dmesg-read takes no arguments"
	# --raw keeps the "<N>" syslog-priority prefix on every line. The kmsg
	# classifier uses it to recognize any KERN_DEBUG line from this driver as
	# a trace, so turning dynamic debug up during an investigation does not
	# turn every case red. lib/kmsg.PREFIX_RE already strips the "<N>[time]"
	# pair, so message-text rules are unaffected.
	exec dmesg --color=never --raw
	;;

dmesg-mark)
	[ $# -eq 1 ] || die "dmesg-mark needs exactly one token"
	# Validated rather than trusted: this string reaches the kernel log, and
	# the runner later slices the log on it. Control characters or newlines
	# would let a token forge a boundary, or split one log line into two.
	[[ $1 =~ ^JT-MARK\ [A-Za-z0-9._:#+-]{1,64}\ [0-9a-f]{8,32}$ ]] \
		|| die "malformed marker token"
	printf '%s\n' "$1" > /dev/kmsg || die "cannot write /dev/kmsg"
	exit 0
	;;

dyndbg-firmware)
	[ $# -eq 1 ] || die "dyndbg-firmware needs on or off"
	case "$1" in
	on)  flag='+p' ;;
	off) flag='-p' ;;
	*)   die "dyndbg-firmware takes on or off" ;;
	esac
	[ -e "$DYNDBG" ] || die "debugfs dynamic_debug not available"
	# The match string is fixed in this file, never taken from the caller.
	# No quoting needed here: this path goes straight to the dynamic debug
	# tokenizer with no parse_args in between, and the match is space-free.
	printf 'format %s %s\n' "$FW_MATCH" "$flag" > "$DYNDBG" \
		|| die "cannot write $DYNDBG"
	exit 0
	;;

dyndbg-hwparams-n)
	[ $# -eq 1 ] || die "dyndbg-hwparams-n needs on or off"
	case "$1" in
	on)  flag='+p' ;;
	off) flag='-p' ;;
	*)   die "dyndbg-hwparams-n takes on or off" ;;
	esac
	[ -e "$DYNDBG" ] || die "debugfs dynamic_debug not available"
	# Same reasoning as dyndbg-firmware: matched by format string, fixed in
	# this file, so the log is not flooded by every other dev_dbg in the
	# driver. Unlike the firmware message this one fires on every
	# hw_params() call (every PCM open), not just at probe, so a live write
	# to the control file is enough -- no modprobe dyndbg= parameter needed.
	printf 'format %s %s\n' "$HWPARAMS_N_MATCH" "$flag" > "$DYNDBG" \
		|| die "cannot write $DYNDBG"
	exit 0
	;;

printk-console)
	[ $# -eq 1 ] || die "printk-console needs a level"
	[[ $1 =~ ^[1-8]$ ]] || die "console loglevel must be 1-8"
	# Only the console level is touched; the other three fields are left as
	# the system set them.
	read -r _cur def minl defl < /proc/sys/kernel/printk \
		|| die "cannot read kernel.printk"
	printf '%s\t%s\t%s\t%s\n' "$1" "$def" "$minl" "$defl" \
		> /proc/sys/kernel/printk || die "cannot set kernel.printk"
	exit 0
	;;

xrun-debug)
	# /proc/asound/cardN/pcm*/xrun_debug is root-owned. Setting it makes the
	# ALSA core log every xrun to the kernel log, which is the only route by
	# which an xrun becomes visible to the classifier -- the per-substream
	# counters in the status file vanish the moment the stream closes.
	#
	# Bit 0 logs the xrun. Higher bits add stack traces and period tracing,
	# which are for a person staring at one failure, not for a suite.
	[ $# -eq 1 ] || die "xrun-debug needs 0 or 1"
	[[ $1 =~ ^[01]$ ]] || die "xrun-debug takes 0 or 1"
	# Only this card's substreams. Globbing /proc/asound/card*/ also reached
	# the onboard HDA, whose logging is nobody's business here and whose xruns
	# would land in the same kernel log the classifier reads.
	proc=$(card_proc) || die "no Jockey 3 card found in /proc/asound"
	n=0
	for f in "$proc"/pcm*/xrun_debug; do
		[ -e "$f" ] || continue
		printf '%s\n' "$1" > "$f" || die "cannot write $f"
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] || die "no xrun_debug under $proc (CONFIG_SND_PCM_XRUN_DEBUG?)"
	echo "xrun_debug=$1 on $n substream(s) of $(basename "$(readlink -f "$proc")")"
	exit 0
	;;

xrun-inject)
	# .../pcm0{p,c}/sub0/xrun_injection is root-owned (mode 0200,
	# CONFIG_SND_PCM_XRUN_DEBUG): any write to it calls snd_pcm_stop_xrun()
	# on that substream directly -- the same core function a genuine
	# buffer underrun/overrun reaches -- letting JT-PCM-009
	# (cases/pcm_xrun_recovery.py) force one deterministically rather than
	# wait for one to happen. Safe against a closed or not-yet-running
	# substream: snd_pcm_stop_xrun() checks substream->runtime and
	# snd_pcm_running() itself and is a no-op otherwise.
	#
	# Only pcm0p or pcm0c is accepted, sub0 is implicit -- this device has
	# exactly one substream per direction, and a bare pcm/sub pair taken
	# from the caller would let a case aim this at any PCM on the system,
	# not just this card's.
	[ $# -eq 1 ] || die "xrun-inject needs pcm0p or pcm0c"
	case "$1" in
	pcm0p | pcm0c) ;;
	*) die "xrun-inject only accepts pcm0p or pcm0c" ;;
	esac
	proc=$(card_proc) || die "no Jockey 3 card found in /proc/asound"
	f="$proc/$1/sub0/xrun_injection"
	[ -e "$f" ] || die "no $f (CONFIG_SND_PCM_XRUN_DEBUG not set?)"
	printf '1\n' > "$f" || die "cannot write $f"
	exit 0
	;;

trace-callbacks)
	# ns-per-callback measurement for JT-PERF-001 (re/streaming_overhead.md):
	# function_graph tracing restricted to the two URB completion handlers,
	# which is what a kernel without CONFIG_FUNCTION_PROFILER (not set on any
	# of this project's -prod configs) still gives for free -- no package,
	# no config change, just CONFIG_FUNCTION_TRACER/FUNCTION_GRAPH_TRACER,
	# both already on. The two function names are fixed above (TRACE_FUNCS),
	# never taken from the caller.
	[ $# -eq 1 ] || die "trace-callbacks needs start, collect or stop"
	tdir=$(tracing_dir) || die "tracefs not mounted"

	case "$1" in
	start)
		for fn in $TRACE_FUNCS; do
			# A module's symbols are listed as "name [module]", not bare, so
			# an exact-line match here always missed -- match the first
			# whitespace-delimited field instead, which is the symbol name
			# whether or not a module suffix follows it.
			awk -v f="$fn" '$1==f{found=1} END{exit !found}' \
				"$tdir/available_filter_functions" \
				|| die "function '$fn' not traceable -- driver not loaded, or renamed/inlined since this verb was written"
		done
		echo 0 > "$tdir/tracing_on" || die "cannot stop tracing to reset it"
		: > "$tdir/trace" || die "cannot clear trace buffer"
		echo nop > "$tdir/current_tracer" || die "cannot reset current_tracer"
		: > "$tdir/set_ftrace_filter" || die "cannot clear set_ftrace_filter"
		for fn in $TRACE_FUNCS; do
			echo "$fn" >> "$tdir/set_ftrace_filter" \
				|| die "cannot filter on $fn"
		done
		# Best-effort: a per-CPU buffer generous enough that a busy interval
		# at 96 kHz does not wrap and silently drop entries before collect
		# reads them. Not fatal if the kernel refuses a larger size.
		echo 32768 > "$tdir/buffer_size_kb" 2>/dev/null || true
		echo function_graph > "$tdir/current_tracer" \
			|| die "cannot select function_graph tracer"
		echo 1 > "$tdir/tracing_on" || die "cannot start tracing"
		exit 0
		;;
	collect)
		echo 0 > "$tdir/tracing_on" || die "cannot stop tracing"
		cat "$tdir/trace" || die "cannot read trace buffer"
		echo nop > "$tdir/current_tracer" 2>/dev/null || true
		: > "$tdir/set_ftrace_filter" 2>/dev/null || true
		: > "$tdir/trace" 2>/dev/null || true
		exit 0
		;;
	stop)
		# Cleanup with no output, for a case that errored before it reached
		# collect -- leaves the host's tracing state as it found it rather
		# than stuck mid-trace for whoever uses ftrace next.
		echo 0 > "$tdir/tracing_on" 2>/dev/null || true
		echo nop > "$tdir/current_tracer" 2>/dev/null || true
		: > "$tdir/set_ftrace_filter" 2>/dev/null || true
		: > "$tdir/trace" 2>/dev/null || true
		exit 0
		;;
	*)
		die "trace-callbacks takes start, collect or stop"
		;;
	esac
	;;

usb-power)
	# Per-port USB power switching, for the disconnect and replug cases. A
	# clean VBUS drop, which is NOT the same event as pulling the cable: a
	# real unplug degrades over several frames and the URBs accumulate -71
	# before the disconnect lands, while this goes straight to -19. The messy
	# variant needs the mains relay; see JT-HOTPLUG-003.
	[ $# -ge 1 ] || die "usb-power needs status, off, on or cycle"
	command -v uhubctl >/dev/null 2>&1 \
		|| die "uhubctl is not installed -- apt install uhubctl"
	action=$1
	shift

	delay=3
	if [ "$action" = cycle ] && [ $# -eq 1 ]; then
		[[ $1 =~ ^[0-9]{1,2}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 30 ] \
			|| die "cycle delay must be 1-30 seconds"
		delay=$1
		shift
	fi
	[ $# -eq 0 ] || die "usb-power $action takes no further arguments"

	case "$action" in
	status | off | cycle)
		# Resolved fresh every time from the device's own ids. The port is
		# never an input, so no argument can widen what this reaches.
		resolved=$(usb_resolve) \
			|| die "no Reloop Jockey 3 behind a ppps-capable hub port"
		read -r hub port hubid <<< "$resolved"
		;;
	esac

	case "$action" in
	status)
		echo "usb-power ok"
		echo "hub=$hub port=$port hub_id=$hubid"
		exit 0
		;;
	off)
		mkdir -p "$USB_STATE_DIR" || die "cannot create $USB_STATE_DIR"
		printf '%s %s %s\n' "$hub" "$port" "$hubid" > "$USB_STATE" \
			|| die "cannot record the port in $USB_STATE"
		exec uhubctl -l "$hub" -p "$port" -a off
		;;
	cycle)
		exec uhubctl -l "$hub" -p "$port" -a cycle -d "$delay"
		;;
	on)
		# The device is gone while the port is dark, so `on` works from what
		# `off` recorded rather than from the bus. Everything read back is
		# re-validated and re-checked against the hardware before acting: a
		# recorded location is a hint about the past, and powering a port
		# whose occupant is no longer known is the one thing this verb must
		# never do.
		[ -r "$USB_STATE" ] \
			|| die "no port recorded -- run 'usb-power off' first (or the machine rebooted)"
		read -r hub port hubid < "$USB_STATE" || die "cannot read $USB_STATE"
		[[ $hub =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]] || die "malformed hub location in $USB_STATE"
		[[ $port =~ ^[0-9]{1,2}$ ]] || die "malformed port in $USB_STATE"
		cur=$(uhubctl -l "$hub" -p "$port" 2>/dev/null) \
			|| die "hub $hub is no longer present"
		printf '%s\n' "$cur" | grep -q "\[$hubid" \
			|| die "the hub at $hub is not the one that was powered down"
		printf '%s\n' "$cur" | grep -qE "Port $port: [0-9a-f]+ off" \
			|| die "port $hub port $port is not powered off"
		rm -f "$USB_STATE"
		exec uhubctl -l "$hub" -p "$port" -a on
		;;
	*)
		die "usb-power takes status, off, on or cycle"
		;;
	esac
	;;

rtcwake-mem)
	[ $# -eq 1 ] || die "rtcwake-mem needs a duration in seconds"
	[[ $1 =~ ^[0-9]{1,4}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 3600 ] \
		|| die "suspend duration must be 1-3600 seconds"
	exec rtcwake -m mem -s "$1"
	;;

*)
	die "unknown verb '$verb'"
	;;
esac
