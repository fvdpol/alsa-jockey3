# ov-snapshot capture-host config.
# Copy to ~/.config/ov-snapshot/capture.toml and edit.
#
# This file belongs to ov-snapshot, not to the jockey3 test suite -- it lives
# in its own ~/.config/ov-snapshot/ directory on purpose, so the tool stays
# decoupled and can move to its own repo unchanged.

[capture]

# Path to a checkout of ov_ftdi -- specifically the directory that holds
# LibOV.py, usb_interp.py and ov3.fwpkg. Use Frank's fork
# (~/jockey3_linux/ov_ftdi), which carries the capture-throughput work; see
# ov_ftdi_capture_performance.md.
ov_ftdi_host_dir = "~/jockey3_linux/ov_ftdi/software/host"

# Firmware package. Defaults to <ov_ftdi_host_dir>/ov3.fwpkg.
# fwpkg = "~/ov_ftdi/software/host/ov3.fwpkg"

# HTTP control endpoint the DUT-side trigger talks to.
listen_host = "0.0.0.0"
listen_port = 8464

# Rolling buffer: seconds of traffic kept before a trigger, and seconds
# recorded after one. RAM cost is roughly 15-20 MB per pre-second at 96 kHz
# duplex; a stalled stream simply yields a short post section.
pre_seconds = 5.0
post_seconds = 5.0

# Discard this many seconds of stream at startup, before the ring starts
# collecting. The OpenVizsla SDRAM capture ring is not cleared between
# sessions (OpenVizslaTNG/ov_ftdi #25); without this drain a warm start can
# read the previous session's leftover bytes and LibOV's framer desyncs where
# the stale data meets the live stream. Measured on this rig: after a clean
# stop the elevated "drain" rate lasts ~2 s -- 4 s is margin. The
# "[ov-snapshot] startup drain: ..." log line reports what was actually
# discarded. 0 disables the drain. (Skipped automatically after an FPGA
# reload, which already leaves the ring clean.)
drain_seconds = 4.0

# On shutdown, disable the capture stream and then wait up to this long for
# the gateware's HF0_LAST end-marker to drain out before cutting the SDRAM
# path, so the ring is left clean for this tool's *own* next run (#25). This
# does not help after a hard kill or another tool -- that is what
# drain_seconds covers. 0 = don't wait (previous behavior).
teardown_drain_timeout = 2.0

# (No knob for it, but note: on a warm start ov-snapshot first tries to turn
# the capture stream off, watchdog'd. If a hard-killed predecessor's stream is
# still running that write blocks -- LibOV cannot recover from it in-process,
# #25 measured ~130 s stalls -- and ov-snapshot exits non-zero with a one-line
# fix (reload the FPGA, or set reload_bitstream below, or let a supervisor
# restart it). A clean shutdown leaves the stream off, so this never fires on
# a normal restart.)

# Reconfigure the FPGA from the bitstream on every start. Default false: a
# PROG_B reload re-inits the OV3's ULPI PHY on the sniffed bus and has been
# seen to knock a DUT off the bus at sniff start (#25), so we leave a warm
# FPGA alone and rely on the startup drain instead. A cold FPGA is always
# loaded regardless. Set true if you want the old always-reload behavior, or
# as the recovery for a wedged stream (see the note above).
reload_bitstream = false

# Where snapshot .txt + .md pairs are written. On the current rig this is the
# Seafile folder, same as manual captures.
output_dir = "~/seafile/usb capture 2026"
filename_prefix = "snapshot"

# Enable the gateware NAK filter (CSTREAM_CFG bit 2). Drops the PING/NAK and
# IN/NAK handshake storm in the FPGA, cutting the host packet rate by ~10x --
# useful when the DUT's handshake traffic (e.g. a Ploytec audio device polling
# its IN endpoints) saturates the single-threaded receive path and overflows
# the SDRAM ring. Safe for ov-snapshot because it does no register I/O while
# streaming; do NOT enable it for a workflow that polls registers mid-capture.
filter_nak = false
